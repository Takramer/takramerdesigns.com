{
  "name": "takd-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 8796 --host 127.0.0.1",
    "build": "astro build && esbuild dist/site.js --minify --allow-overwrite --outfile=dist/site.js --log-level=warning",
    "preview": "astro preview --port 8797 --host 127.0.0.1",
    "build:preview": "PUBLIC_NOTES=1 astro build"
  },
  "dependencies": {
    "astro": "^7.4.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.2",
    "agentation": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wrangler": "^4.156.0"
  }
}
